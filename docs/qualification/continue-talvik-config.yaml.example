name: Talvik local coding
version: 1.0.0
schema: v1

# Copy this model entry into a separate local Continue configuration. Replace
# the placeholder with a token created for the local Talvik daemon. Do not
# commit the completed file or the token.
models:
  - name: Talvik DeepSeek Coder
    provider: openai
    apiBase: http://127.0.0.1:11434/v1
    apiKey: REPLACE_WITH_TALVIK_TOKEN
    model: deepseek-coder-1.3b
    contextLength: 4096
    completionOptions:
      temperature: 0
      maxTokens: 256

# Optional second model for manual comparison:
