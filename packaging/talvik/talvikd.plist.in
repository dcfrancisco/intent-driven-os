<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.talvik.talvikd</string>
  <key>ProgramArguments</key>
  <array>
    <string>__TALVIK_HOME__/bin/talvikd</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TALVIK_HTTP_ADDR</key>
    <string>127.0.0.1:11435</string>
    <key>TALVIK_HTTP_CONTEXT_SIZE</key>
    <string>32768</string>
    <key>TALVIK_HTTP_MAX_TOKENS</key>
    <string>2048</string>
    <key>TALVIK_ENABLE_THINKING</key>
    <string>false</string>
    <key>TALVIK_ADMISSION_TIMEOUT_SECONDS</key>
    <string>180</string>
    <key>TALVIK_HOME</key>
    <string>__TALVIK_HOME__</string>
    <key>TALVIK_STATE_DIR</key>
    <string>__TALVIK_HOME__</string>
    <key>TALVIK_MODEL_DIR</key>
    <string>__TALVIK_HOME__/models</string>
    <key>TALVIK_REGISTRY</key>
    <string>__TALVIK_HOME__/models.registry</string>
    <key>TALVIK_TOKEN_FILE</key>
    <string>__TALVIK_HOME__/tokens</string>
  </dict>
  <key>KeepAlive</key>
  <true/>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__TALVIK_HOME__/logs/talvikd.log</string>
  <key>StandardErrorPath</key>
  <string>__TALVIK_HOME__/logs/talvikd.error.log</string>
</dict>
</plist>
